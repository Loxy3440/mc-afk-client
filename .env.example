# Required: at least 16 characters. Used for the dashboard HTTP Basic Auth.
DASHBOARD_PASSWORD=replace-with-a-long-random-value
PORT=3000

# Required to encrypt per-account server /login passwords. Use a random value of at least 32 characters.
ACCOUNT_ENCRYPTION_KEY=replace-with-a-random-32-character-or-longer-secret

# Optional internal ports for browser world viewers and parallel session limit.
VIEWER_PORT_BASE=32000
MAX_ACTIVE_BOTS=3
