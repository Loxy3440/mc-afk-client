# Required to protect the web panel. Use at least 16 random characters.
DASHBOARD_PASSWORD=replace-with-a-long-random-value
PORT=3000

# Minecraft connection settings; these may also be set in the web panel.
MC_SERVER_HOST=
MC_SERVER_PORT=25565
MC_VERSION=
MC_USERNAME=
MC_AUTH_MODE=microsoft

# Only for a server /login command. This is not your Microsoft password.
MC_LOGIN_PASSWORD=
